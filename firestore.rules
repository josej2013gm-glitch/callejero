rules_version = '2';

// Reglas de seguridad de Cloud Firestore para Estudio de Callejero.
//
// · Solo cuentas de Google con correo verificado.
// · Solo el propietario (__OWNER_EMAIL__, se sustituye al publicar con la variable
//   VITE_OWNER_EMAIL del repositorio) y las cuentas que él autorice en config/access.
// · Cada usuario solo puede leer y escribir dentro de users/{su uid}.
// · Todo lo demás está denegado.

service cloud.firestore {
  match /databases/{database}/documents {

    function google() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAppOwner() {
      return google() && email() == '__OWNER_EMAIL__';
    }
    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }
    function authorized() {
      return isAppOwner()
        || (google() && exists(accessPath()) && email() in get(accessPath()).data.emails);
    }
    function isOwner(uid) {
      return authorized() && request.auth.uid == uid;
    }
    // Límite de tamaño razonable (Firestore admite hasta 1 MiB por documento)
    function smallSession() {
      return request.resource.data.keys().size() <= 20
        && (!('answers' in request.resource.data) || request.resource.data.answers.size() <= 200)
        && (!('wrongQs' in request.resource.data) || (request.resource.data.wrongQs is string && request.resource.data.wrongQs.size() <= 400000));
    }

    // Lista de cuentas autorizadas: solo la gestiona el propietario
    match /config/access {
      allow read: if isAppOwner();
      allow write: if isAppOwner()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
    }

    // Perfil y ajustes
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['settings', 'email', 'name', 'updatedAt']);

      // Progreso de repaso espaciado y correcciones de cada municipio:
      // progress / overrides (Cieza) y progress-<municipio> / overrides-<municipio>
      match /state/{docId} {
        allow read, write: if isOwner(uid) && docId.matches('^(progress|overrides)(-[a-z0-9-]{1,30})?$');
      }

      // Historial: un documento por sesión o simulacro
      match /sessions/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && sid.size() <= 40
          && request.resource.data.id == sid
          && request.resource.data.endedAt is number
          && request.resource.data.mode in ['oficial', 'simulacro', 'entrenamiento', 'mudo', 'repaso']
          && (!('muni' in request.resource.data) || (request.resource.data.muni is string && request.resource.data.muni.size() <= 30))
          && smallSession();
      }
    }

    // Cualquier otra ruta: denegada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
